+static bool kitsune_check(uid_t uid, const char *process, const char *field, bool fallback) {
+  char id[16], output[256], needle[64];
+  snprintf(id, sizeof(id), "%u", uid);
+  const char *const args[] = { "magisk", "--hide", "check", id, process, NULL };
+  if (!exec_command(output, sizeof(output), path_to_magisk, args) ||
+      strncmp(output, "{\"schema\":1,", strlen("{\"schema\":1,")) != 0) return fallback;
+  snprintf(needle, sizeof(needle), "\"%s\":true", field);
+  if (strstr(output, needle)) return true;
+  snprintf(needle, sizeof(needle), "\"%s\":false", field);
+  if (strstr(output, needle)) return false;
+  return fallback;
