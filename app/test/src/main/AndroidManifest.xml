<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <queries tools:node="removeAll" />

    <application tools:node="replace">
        <uses-library android:name="android.test.runner" />
        <service android:name="com.topjohnwu.magisk.test.HideProbeService"
            android:process=":hide_probe" android:exported="false" />
        <service android:name="com.topjohnwu.magisk.test.HideIsolatedService"
            android:process=":hide_isolated" android:isolatedProcess="true" android:exported="false" />
        <service android:name="com.topjohnwu.magisk.test.HideProbeContainer$NestedService"
            android:process=":hide_nested" android:isolatedProcess="true" android:exported="false" />
        <service android:name="com.topjohnwu.magisk.test.HideAppZygoteService"
            android:process=":hide_appzygote" android:isolatedProcess="true"
            android:useAppZygote="true" android:exported="false" />
    </application>

    <instrumentation
        android:name="com.topjohnwu.magisk.test.AppTestRunner"
        android:targetPackage="${magiskAppId}" />

    <instrumentation
        android:name="com.topjohnwu.magisk.test.TestRunner"
        android:targetPackage="${magiskTestAppId}" />

</manifest>
